NODE_ENV=development

# Pooled Neon connection for application traffic (hostname contains -pooler).
DATABASE_URL=

# Direct Neon connection for Prisma migrations only. Same credentials, hostname without -pooler.
# Required for npm run db:migrate. The running app uses DATABASE_URL.
DIRECT_URL=

# Cryptographically random secret, at least 32 characters. Never use a placeholder in production.
JWT_SECRET=

# Spec ceiling is 7d. Prefer 12h in production because payslips are sensitive.
JWT_EXPIRY=7d

# SMTP. Set SMTP_SECURE explicitly: true for implicit TLS, false for STARTTLS.
# Do not infer TLS from the port. Leave blank in development until email is configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# One-time Super Admin bootstrap. Do not leave a password here.
# Prefer: npm run bootstrap:super-admin -- --email you@company.com --password "<one-time>"
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=
